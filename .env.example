# ╔══════════════════════════════════════════════════════════════════════════╗
# ║                    Work&Study — конфигурация                            ║
# ║  Скопируй этот файл в .env и заполни нужные поля                        ║
# ║  cp .env.example .env                                                   ║
# ╚══════════════════════════════════════════════════════════════════════════╝

# ── База данных (Docker создаёт автоматически) ────────────────────────────
POSTGRES_DB=workstudy
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# ── JWT ───────────────────────────────────────────────────────────────────
# ВАЖНО: смени секрет перед деплоем в продакшн!
JWT_SECRET=workstudy_secret_change_me_in_production
JWT_EXPIRES_IN=7d

# ── Email верификация ─────────────────────────────────────────────────────
# true = регистрация без подтверждения email (рекомендуется для демо/разработки)
# false = нужны реальные Gmail-реквизиты ниже
AUTO_VERIFY=true

# ── Gmail SMTP (нужен только если AUTO_VERIFY=false) ─────────────────────
# Инструкция: https://support.google.com/accounts/answer/185833
GMAIL_USER=
GMAIL_APP_PASSWORD=

# ── Cloudinary (загрузка аватарок и резюме) ───────────────────────────────
# Без этого загрузка файлов не работает, но всё остальное работает
# Регистрация бесплатно: https://cloudinary.com
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Telegram Bot (уведомления о заявках) ──────────────────────────────────
# Без этого уведомления в Telegram не работают, всё остальное — да
# Создать бота: @BotFather в Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=WorkStudyBot
