# ===================================================
# Work&Study Frontend — переменные окружения
# Скопируй в .env и заполни:
#   cp .env.example .env
# ===================================================

# URL бэкенда (без слеша в конце)
# Разработка (бэкенд на localhost:8000):
VITE_API_URL=http://localhost:8000/api/v1

# Продакшн через Docker (nginx проксирует /api/ → backend):
# VITE_API_URL=/api/v1

# Продакшн с отдельным доменом для API:
# VITE_API_URL=https://api.yourdomain.com/api/v1
