# ===================================================
# Work&Study Backend — переменные окружения
# Скопируй в .env и заполни значения:
#   cp .env.example .env
# ===================================================

# Сервер
PORT=8000

# База данных PostgreSQL
# Для локальной разработки (docker-compose up -d запустит БД на порту 5433):
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/workstudy?schema=public
# Для продакшн: postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public

# Postgres (используется в docker-compose.prod.yml)
POSTGRES_DB=workstudy
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_strong_password

# JWT
JWT_SECRET=change_me_to_a_long_random_string_at_least_32_chars
JWT_EXPIRES_IN=7d

# URL фронтенда (CORS)
# Разработка:
FRONTEND_URL=http://localhost:5173
# Продакшн: https://yourdomain.com

# ===================================================
# Email (Gmail SMTP)
# Настройка: Google Account → Security → 2FA → App passwords
# Создай пароль для приложения "Почта" и вставь сюда
# ===================================================
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=xxxx_xxxx_xxxx_xxxx

# ===================================================
# Cloudinary (аватары, резюме PDF, логотипы компаний)
# Регистрация: https://cloudinary.com — бесплатно 25 GB
# Dashboard → API Keys
# ===================================================
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ===================================================
# Telegram Bot (уведомления о заявках и тикетах)
# Настройка:
#   1. Напишите @BotFather → /newbot → следуйте инструкциям
#   2. Скопируйте токен ниже
#   3. TELEGRAM_BOT_USERNAME — username бота БЕЗ @
# ===================================================
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ
TELEGRAM_BOT_USERNAME=WorkStudyBot
