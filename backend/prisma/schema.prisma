generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  student
  hr
  admin
}

enum WorkType {
  remote
  office
  hybrid
}

enum InternshipStatus {
  pending
  published
  closed
  rejected
}

enum ApplicationStatus {
  pending
  accepted
  rejected
}

enum TicketStatus {
  open
  resolved
}

model User {
  id             Int      @id @default(autoincrement())
  name           String
  email          String   @unique
  password       String
  role           Role     @default(student)
  isBlocked      Boolean  @default(false)
  isVerified     Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Общий профиль
  avatarUrl      String?
  telegramId     String?
  phone          String?
  bio            String?
  skills         String[]

  // Только студент
  university     String?
  major          String?
  gpa            Float?
  graduationYear Int?
  resumeUrl      String?
  cvExperience   Json?    // WorkExperience[]
  cvLanguages    Json?    // CvLanguage[]

  // Только HR
  company        String?

  internships    Internship[]
  applications   Application[]
  tickets        SupportTicket[]
  notifications  Notification[]
  bookmarks      Bookmark[]
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  type      String   // new_application | application_status | moderation_result | support_reply | new_ticket | new_internship
  title     String
  body      String
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, isRead])
}

model SupportTicket {
  id         Int          @id @default(autoincrement())
  userId     Int
  subject    String
  message    String
  status     TicketStatus @default(open)
  adminReply String?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  user User @relation(fields: [userId], references: [id])
}

model Internship {
  id           Int              @id @default(autoincrement())
  title        String
  company      String
  description  String
  requirements String[]
  skills       String[]
  city         String
  workType     WorkType         @default(office)
  salary       Float            @default(0)
  duration     String?
  deadline     DateTime?
  companyLogo     String?
  status          InternshipStatus @default(pending)
  rejectionReason String?
  viewsCount      Int              @default(0)
  postedById      Int
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  postedBy     User          @relation(fields: [postedById], references: [id])
  applications Application[]
  bookmarks    Bookmark[]
}

model Bookmark {
  id           Int      @id @default(autoincrement())
  userId       Int
  internshipId Int
  createdAt    DateTime @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  internship Internship @relation(fields: [internshipId], references: [id], onDelete: Cascade)

  @@unique([userId, internshipId])
}

model VerificationCode {
  id        Int      @id @default(autoincrement())
  email     String
  code      String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
}

model PasswordReset {
  id        Int      @id @default(autoincrement())
  email     String
  code      String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
}

model Application {
  id           Int               @id @default(autoincrement())
  studentId    Int
  internshipId Int
  coverLetter  String
  resumeUrl    String?
  status       ApplicationStatus @default(pending)
  feedback     String            @default("")
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  student    User       @relation(fields: [studentId], references: [id])
  internship Internship @relation(fields: [internshipId], references: [id])

  @@unique([studentId, internshipId])
}
